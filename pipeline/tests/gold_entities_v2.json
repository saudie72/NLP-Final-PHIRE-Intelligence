{
 "about": "Gold set v2: hand-labelled entities for 30 different synthetic demo tickets (data/synthetic/phire_test.csv, excluding the v1 tickets), sampled with random.Random(2027): 9 Functional, 9 Technical, 6 Security, 6 Administration. Labelled by the coordinating session on 2026-11-24 following docs/entity-labelling-guide.md, from the ticket text only and before running spaCy on these tickets. Written after the round-1 errors were analysed on gold set v1, so it is the unseen set for round 2.",
 "guide": "docs/entity-labelling-guide.md",
 "labels": {
  "PS_MODULE": "PeopleSoft product area or menu root (Time and Labor, Workforce Administration, PeopleTools, ePerformance ...)",
  "PS_PAGE": "page or component a user opens (Job Data, Timesheet, Process Monitor, Report Manager, Expense Report ...)",
  "PS_PROCESS": "batch or business process (Pay Calculation, Load Time and Labor, budget check, billing interface ...)",
  "PS_FIELD": "field or setup value type (Workgroup, Expense Type, time reporting code, federal withholding, Balance)",
  "PS_TOOL": "PeopleTools technology or infrastructure (PeopleCode, COBOL, PUM, PS Query, Process Scheduler, Candidate Gateway, IB, department security tree)",
  "PS_PROGRAM": "named program or object in CAPS (HR_JOB, PSPPYRUN)",
  "PS_ENV": "environment (DEV, TST, UAT, TRN, CFG)",
  "TICKET_REF": "PHIRE issue / CR number",
  "USER_ID": "user ID (synthetic SYNUSERnnnn)",
  "BUSINESS_UNIT": "business unit: 'Business Unit = XX', 'BU XX', or a bare BU code used as one",
  "DATE": "calendar date, date part only (not 'PPE')",
  "ORG": "county department",
  "PS_ROLE": "named security or business role used as a role (assigned, held, missing, needed); never the word 'role(s)'"
 },
 "rules": [
  "Navigation paths: label the module/menu root as PS_MODULE and the final page as PS_PAGE; skip intermediate menu folders.",
  "Named roles are PS_ROLE only when used as a role (held, assigned, missing); a role name used as the subject of a sentence ('Security Administrator can't see ...') is not labelled (guide decision 2).",
  "Bare 'PPE' is not an entity; only the date after it is DATE (guide decision 1).",
  "Lowercase business words (encumbrance, deduction, receipt, change order) are not labelled unless they name a field, code or process (guide decision 4)."
 ],
